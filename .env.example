# ==============================================================================
# GETNET MULTI-AGENT CUSTOMER SUPPORT — CONFIGURAÇÕES DE AMBIENTE (.env)
# ==============================================================================

# 1. Chaves de API das LLMs (Obrigatório)
OPENAI_API_KEY=sk-...

# 2. Modelos de LLM (Padrão: gpt-4o-mini para excelente equilíbrio de custo/velocidade/acurácia)
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.0
AGENT_MAX_ITERATIONS=10

# Opcional: Especificar modelos dedicados por especialista (se omitido, usa AGENT_MODEL)
# ROUTER_MODEL=gpt-4o-mini
# SUPPORT_MODEL=gpt-4o-mini
# KNOWLEDGE_MODEL=gpt-4o-mini
# ESCALATION_MODEL=gpt-4o-mini

# 3. Base Vetorial e Banco de Dados (ChromaDB + SQLite)
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=bds/chroma_db
CHECKPOINT_DB_PATH=bds/checkpoints.sqlite
CONFIG_DB_PATH=bds/config.db
RAG_SYNC_DB_PATH=bds/rag_sync.sqlite
RAG_SYNC_MODE=simple

# 4. URLs de Sincronização e Web Crawler do RAG
RAG_ASYNC_URLS=https://www.getnet.eu/pt/suporte, https://site.getnet.com.br/get-ajuda/
RAG_SYNC_URLS=https://site.getnet.com.br/blog/
RAG_CRAWLER_MAX_DEPTH=2
RAG_CRAWLER_MAX_PAGES=100
RAG_WEB_SYNC_CRON=0 3 * * *

# 5. Configurações de API e CORS
BACKEND_CORS_ORIGINS=["*"]

# 6. Observabilidade e Rastreamento (LangSmith / LangChain - Opcional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=sua-chave-langsmith-aqui
LANGCHAIN_PROJECT=desafio-get
